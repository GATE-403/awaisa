{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node dist/database/migrate.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typeorm": "typeorm -d dist/database/data-source.js",
    "migration:generate": "pnpm build && typeorm -d dist/database/data-source.js migration:generate src/database/migrations/Migration",
    "migration:run": "typeorm -d dist/database/data-source.js migration:run",
    "migration:revert": "typeorm -d dist/database/data-source.js migration:revert",
    "seed:demo": "node scripts/seed-demo.ts",
    "db:slow": "node scripts/slow-queries.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.3",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "passkit-generator": "^3.7.0",
    "pg": "^8.23.1",
    "redis": "^5.12.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
