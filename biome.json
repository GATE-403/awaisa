{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.next-e2e",
      "!**/.turbo",
      "!**/.expo",
      "!**/dist",
      "!**/dist-e2e",
      "!**/build",
      "!**/coverage"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noDefaultExport": "error",
        "useBlockStatements": "off",
        "noNonNullAssertion": "error"
      },
      "complexity": {
        "useArrowFunction": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        }
      },
      "performance": {
        "noNamespaceImport": "error"
      },
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Checkbox", "Switch", "Input", "Radio", "Select"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/src/app/**/page.tsx",
        "**/src/app/**/layout.tsx",
        "**/src/app/**/not-found.tsx",
        "**/src/app/**/error.tsx",
        "**/src/app/**/loading.tsx",
        "**/*.config.ts",
        "**/*.d.ts",
        "**/e2e/globalTeardown.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "cssModules": true
    }
  }
}
