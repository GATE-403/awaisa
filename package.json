{
  "name": "awaisa",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "test:e2e": "pnpm --filter web test:e2e",
    "db:seed": "pnpm --filter api seed:demo",
    "test:ux": "pnpm --filter @awaisa/ux-tests ux",
    "test:a11y": "pnpm --filter @awaisa/ux-tests test:a11y",
    "test:ux:report": "pnpm --filter @awaisa/ux-tests report",
    "rec:eval": "pnpm --filter @awaisa/recsys-eval eval",
    "rec:judge": "pnpm --filter @awaisa/recsys-eval judge",
    "rec:traffic": "pnpm --filter @awaisa/recsys-eval traffic"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@11.17.0"
}
