POSTGRES_USER=awaisa
POSTGRES_PASSWORD=awaisa
POSTGRES_DB=awaisa
POSTGRES_PORT=5432

NODE_ENV=development
# The installation's country and city live in region.json next to this file (copy
# region.example.json): phone format, currency, time zone, map, districts. REGION_FILE points
# elsewhere. Without it development uses the example; production refuses to start.
REGION_FILE=
API_PORT=4000
DATABASE_URL=postgres://awaisa:awaisa@localhost:5432/awaisa
# Connections per process (keep instances × pool under the server's max_connections) and the
# longest a single query may run before Postgres cancels it.
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
WEB_ORIGIN=http://localhost:3000
# Which proxies may name the client's IP (the per-IP limits below count by it). Empty: only our
# own network (the web server, a proxy on this host). Behind Cloudflare: a hop count, e.g. 2.
TRUST_PROXY=
# Per-IP limits (requests per minute); the catalog endpoint is not limited
RATE_LIMIT_PER_MINUTE=120
BOOKING_RATE_LIMIT_PER_MINUTE=5
AUTH_RATE_LIMIT_PER_MINUTE=5

# Public site URL used in SMS links (defaults to the first WEB_ORIGIN)
PUBLIC_WEB_URL=http://localhost:3000
# Signs one-time codes; required in production, at least 32 characters (openssl rand -base64 48)
AUTH_SECRET=
# Staff phones that can open /admin, comma separated
ADMIN_PHONES=

# Countries texts and login codes may go to (calling codes, comma separated; * = any). Every SMS
# costs money and foreign premium numbers are what SMS-pumping bots target. Default: 996.
SMS_ALLOWED_COUNTRY_CODES=996

# Login codes go to Telegram first when set (https://gateway.telegram.org, ~$0.01 per code); SMS is the fallback
TELEGRAM_GATEWAY_TOKEN=

# Client messages in WhatsApp (Meta WhatsApp Business Cloud API, approved templates: docs/whatsapp.md).
# Order: the client's linked Telegram, then WhatsApp, then SMS (also when WhatsApp refuses a message).
# WHATSAPP_DRIVER: meta | log | off; default meta with a token and number id, else log (off in production).
WHATSAPP_DRIVER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_LANGUAGE=ru
# Delivery status webhook (https://<api>/whatsapp/webhook): the verify token you choose and the app secret
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Owners' bot (@BotFather): bookings, cancellations, reviews and the 9:00 schedule in Telegram.
# The username turns the cabinet's «Подключить Telegram» on; without a token messages are only logged.
# With TELEGRAM_WEBHOOK_URL (https://<api>/telegram/webhook) Telegram pushes updates; otherwise the API long-polls.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# Platform alerts (new server errors, a burst of browser errors, failed cron jobs, Redis down)
# from the worker to this chat through the bot above. Send /chatid to the bot to get the id.
ALERT_TELEGRAM_CHAT_ID=

# Web Push to owners, administrators and masters about bookings (browsers and the installed app;
# on iPhone only after «На экран Домой»). Generate the pair once and keep it: a new pair drops every
# subscription. `npx web-push generate-vapid-keys` (from apps/api). SUBJECT is mailto: or https://,
# the site's address by default. Empty keys = the feature is hidden and pushes are only logged.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Pushes to the Expo app (expo.dev → Access tokens, with enhanced push security on); empty = logged only
EXPO_ACCESS_TOKEN=

# Error reports to Sentry or GlitchTip (same SDK), server-side only and scrubbed of phones and
# query strings. Empty = off. RELEASE is e.g. the git commit, so an issue shows which deploy.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# SMS: console (logs messages, default) or twilio
SMS_DRIVER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a sender number/name or a Messaging Service SID
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

WEB_PORT=3000
# Public address of the web app for canonical URLs, the sitemap, robots.txt and Open Graph (default https://awaisa.kg).
# Inlined at build time, so set it before `next build`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_URL=http://localhost:4000

# Photos: local disk by default (served from /api/media). For production use S3-compatible storage
# such as Cloudflare R2: set STORAGE_DRIVER=s3 and the S3_* values (S3_PUBLIC_URL = public bucket URL).
# STORAGE_DRIVER=local
# UPLOAD_DIR=uploads
# S3_BUCKET=
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.awaisa.kg

# Apple Wallet passes (needs an Apple Developer account, $99/yr): a Pass Type ID certificate
# exported as PEM. PEM values may be pasted with \n escapes or base64-encoded.
# WALLET_PASS_TYPE_ID=pass.kg.awaisa.booking
# WALLET_TEAM_ID=
# WALLET_CERT_PEM=
# WALLET_KEY_PEM=
# WALLET_KEY_PASSPHRASE=
# WALLET_WWDR_PEM=
# Google Wallet: issuer id from pay.google.com/business/console and a service account key (JSON or base64).
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT=

# Map tiles for the web app (default: OpenStreetMap, fine for development and low traffic).
# NEXT_PUBLIC_MAP_TILES_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=...
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
# Dark-theme tiles (without it the dark theme dims the light tiles with a CSS filter):
# NEXT_PUBLIC_MAP_TILES_URL_DARK=https://api.maptiler.com/maps/streets-v2-dark/{z}/{x}/{y}.png?key=...
# NEXT_PUBLIC_MAP_ATTRIBUTION_DARK=&copy; MapTiler &copy; OpenStreetMap contributors

# Prepayments (deposits on services): test = built-in /pay page (dev, e2e; default outside production),
# none = off (default in production), freedompay = cards through Freedom Pay (Kyrgyzstan).
PAYMENT_DRIVER=
# Freedom Pay merchant (personal account → settings). Result URL to give them:
# <PUBLIC_WEB_URL>/api/payments/freedompay/result
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
# Defaults: https://api.freedompay.kg, KGS. TESTING_MODE=true sends pg_testing_mode=1 (their test cards).
FREEDOMPAY_API_URL=
FREEDOMPAY_CURRENCY=
FREEDOMPAY_TESTING_MODE=

# Fiscal receipts (cashdesk sales, visits paid in money, their refunds): log = numbered here and
# only logged (default outside production), off = none (default in production), ekassa = each
# business's own eKassa cloud register (its login in «Настройки → Касса»; API calls wait for
# eKassa's API description). EKASSA_API_URL defaults to https://test.ekassa.kg/api.
FISCAL_DRIVER=
EKASSA_API_URL=

# Cache for public API answers. Without it the API caches in its own memory; API_CACHE=off turns caching off.
REDIS_URL=redis://localhost:6379

# Process role (set it in the process environment, not here): `all` (default) serves HTTP and runs
# cron jobs; production runs `api` instances (HTTP only, scalable) plus one `worker`
# (node dist/worker.js: cron jobs, Telegram long-poll) and `node dist/database/migrate.js` once per
# deploy. Split roles need REDIS_URL: one cache and one set of rate-limit counters for all.
# PROCESS_ROLE=all

# recsys_eval: LLM judge for persona checks (pnpm rec:judge). Never commit a real key.
# ANTHROPIC_API_KEY=

# «Для вас» interleaving test (docs/recsys/experiments.md): another scorer drafted into the shelves of
# a share of devices, e.g. score-v1:50; results at GET /recommendations/interleaving. Empty = off.
# RECS_INTERLEAVE=

# Address search for branches (the cabinet's branch sheet): photon (OpenStreetMap, no key) or off.
GEOCODER=photon
PHOTON_URL=https://photon.komoot.io
